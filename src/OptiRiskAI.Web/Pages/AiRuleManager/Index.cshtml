@page
@model OptiRiskAI.Web.Pages.AiRuleManager.IndexModel
@{
    ViewData["Title"] = "Otonom Kural Yöneticisi";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">🧠 Agentic Workflow: Doğal Dil ile Kural Üretimi</h5>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.Prompt" class="form-label fw-bold">Yapay Zekaya Ne Yapmasını İstediğinizi Söyleyin:</label>
                <textarea asp-for="Input.Prompt" class="form-control" rows="4" placeholder="Örn: Eğer rüzgar hızı 70'i aşarsa ve bitki örtüsü Çam Ormanı ise risk çarpanını 4.0 yap..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary px-4">Otonom Ajanı Tetikle</button>
        </form>
    </div>
</div>

@if (Model.GeneratedRule != null)
{
    <div class="alert alert-success mt-4 shadow-sm border-0 border-start border-5 border-success">
        <h4 class="alert-heading">✅ Kural Başarıyla Üretildi ve Sisteme Eklendi!</h4>
        <hr>
        <p class="mb-1"><strong>Kural Adı:</strong> @Model.GeneratedRule.RuleName</p>
        <p class="mb-1"><strong>Mantıksal Koşul (NCalc):</strong> <code>@Model.GeneratedRule.ConditionExpression</code></p>
        <p class="mb-1"><strong>Risk Çarpanı:</strong> <span class="badge bg-danger fs-6">@Model.GeneratedRule.RiskMultiplier</span></p>
        <p class="mb-0 mt-2 text-muted"><strong>Yapay Zeka Gerekçesi:</strong> <em>@Model.GeneratedRule.AiRationale</em></p>
    </div>
}