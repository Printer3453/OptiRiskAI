@page
@{
    ViewData["Title"] = "OptiRisk AI - Hiper-Lokal Risk Haritası";
}

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="row mt-3">
    <!-- Harita Paneli -->
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white fw-bold">
                🌍 OptiRisk ZAS - Canlı Analiz Haritası
            </div>
            <div class="card-body p-0">
                <div id="map" style="height: 600px; width: 100%;"></div>
            </div>
        </div>
    </div>

    <!-- Sonuç Paneli -->
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-danger text-white fw-bold">
                📊 Deterministik Risk Sonucu
            </div>
            <div class="card-body">
                <p class="text-muted small">Harita üzerinden bir lokasyon seçerek analizi başlatın.</p>

                <h6 class="fw-bold mt-3">Seçilen Koordinatlar:</h6>
                <p id="coord-display" class="border p-2 bg-light">-</p>

                <h6 class="fw-bold mt-3">Hesaplanan Risk Skoru (C# Motoru):</h6>
                <h2 id="score-display" class="text-center display-4 fw-bold text-secondary">0</h2>

                <hr />
                <button class="btn btn-primary w-100 mt-2" onclick="alert('Faz 3: Semantic Kernel Ajanı Yakında Bağlanacak!')">Ajanı Tetikle (İş Emri Üret)</button>
            </div>
        </div>
    </div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Haritayı Türkiye merkezli başlat
        var map = L.map('map').setView([38.96, 35.24], 6);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(map);

        // riskli alanı haritada görsel olarak belirt (Antalya bölgesi)
        var riskBounds = [[36.5, 31.0], [37.5, 32.0]];
        L.rectangle(riskBounds, {color: "#ff7800", weight: 1, fillOpacity: 0.2}).addTo(map);

        var currentMarker = null;

        // Haritaya Tıklama Olayı (AJAX POST)
        map.on('click', function(e) {
            var lat = e.latlng.lat;
            var lng = e.latlng.lng;

            if(currentMarker) { map.removeLayer(currentMarker); }
            currentMarker = L.marker([lat, lng]).addTo(map);

            document.getElementById('coord-display').innerText = lat.toFixed(4) + ", " + lng.toFixed(4);
            document.getElementById('score-display').innerText = "Hesaplanıyor...";

            // C# Backend'ine veri gönderimi
            fetch('/api/app/risk-analysis/submit-telemetry-and-analyze', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    latitude: lat,
                    longitude: lng,
                    distanceToPowerLineMeters: 0,
                    windSpeedKmh: 0,
                    slopePercentage: 0,
                    vegetationType: "Bilinmiyor"
                })
            })
            .then(response => response.json())
            .then(data => {
                var scoreElement = document.getElementById('score-display');
                scoreElement.innerText = data.calculatedRiskMultiplier;

                if(data.calculatedRiskMultiplier > 80) {
                    scoreElement.className = "text-center display-4 fw-bold text-danger";
                } else {
                    scoreElement.className = "text-center display-4 fw-bold text-success";
                }
            })
            .catch(error => console.error('Hata:', error));
        });
    });
</script>