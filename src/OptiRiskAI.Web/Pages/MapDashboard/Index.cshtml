@page
@{
    ViewData["Title"] = "OptiRisk AI - Komuta Kontrol Merkezi";
}

<!-- Leaflet CSS & FontAwesome -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .terminal-container {
        background-color: #0d1117;
        color: #58d68d;
        font-family: 'Courier New', Courier, monospace;
        height: 450px;
        overflow-y: auto;
        padding: 15px;
        border-radius: 8px;
        font-size: 0.85rem;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
    }

    .log-entry {
        margin-bottom: 8px;
        padding-bottom: 5px;
        border-bottom: 1px dashed #283747;
    }

    .log-time {
        color: #85c1e9;
    }

    .log-critical {
        color: #e74c3c;
        font-weight: bold;
    }

    .log-safe {
        color: #58d68d;
    }

    .radar-pulse {
        animation: pulse-ring 2s infinite;
    }

    @@keyframes pulse-ring {
        0% {
            box-shadow: 0 0 0 0 rgba(0, 123, 255, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(0, 123, 255, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(0, 123, 255, 0);
        }
    }
</style>

<div class="row mt-3">
    <!-- Sol Panel: Canlı Harita -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-satellite-dish"></i> ZAS Otonom Uydu Radarı</span>
                <button id="btn-radar" class="btn btn-sm btn-primary fw-bold radar-pulse" onclick="toggleRadar()">
                    <i class="fa-solid fa-play"></i> Otonom Radarı Başlat
                </button>
            </div>
            <div class="card-body p-0 position-relative">
                <div id="map" style="height: 650px; width: 100%; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;"></div>

                <div id="radar-status" class="position-absolute top-0 start-0 m-3 p-2 bg-dark text-white rounded d-none" style="z-index: 1000; opacity: 0.9;">
                    <i class="fa-solid fa-circle-notch fa-spin text-primary"></i> <span class="small fw-bold">Otonom Tarama Aktif...</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Sağ Panel: Komuta Terminali -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 h-100 bg-dark">
            <div class="card-header bg-black text-white fw-bold d-flex justify-content-between align-items-center border-bottom border-secondary">
                <span><i class="fa-solid fa-terminal"></i> AI Ajan Canlı Günlüğü</span>
                <span class="badge bg-danger" style="font-size: 0.70rem;">CANLI (LIVE)</span>
            </div>
            <div class="card-body p-2">
                <!-- Matrix Terminali -->
                <div id="terminal" class="terminal-container">
                    <div class="text-center text-muted mb-3">
                        <i class="fa-brands fa-space-awesome fa-2x mb-2"></i><br />
                        Sistem Hazır. Otonom motor veya manuel giriş bekleniyor...
                    </div>
                </div>

                <hr class="border-secondary my-2" />

                <!-- Manuel Kontrol Bilgisi -->
                <div class="p-2 text-secondary small">
                    <i class="fa-solid fa-circle-info"></i> Otonom motor çalışırken haritaya tıklayarak anlık manuel (override) analiz yapabilirsiniz.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    let map, markerGroup;
    let isRadarActive = false;
    let radarInterval;
    let processedGuids = new Set(); // Aynı logları tekrar yazdırmamak için

    document.addEventListener("DOMContentLoaded", function() {
        // Haritayı Antalya Merkeze Odakla
        map = L.map('map').setView([36.85, 31.40], 9);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);

        // Manavgat Odak Bölgesi
        L.rectangle([[36.65, 31.20], [37.10, 31.70]], { color: "#28a745", weight: 2, fillOpacity: 0.1 }).addTo(map);
        markerGroup = L.layerGroup().addTo(map);

        // Manuel Tıklama (Override)
        map.on('click', function(e) {
            triggerManualAnalysis(e.latlng.lat, e.latlng.lng);
        });
    });

    // Otonom Radarı Aç/Kapat
    function toggleRadar() {
        const btn = document.getElementById('btn-radar');
        const status = document.getElementById('radar-status');

        isRadarActive = !isRadarActive;

        if (isRadarActive) {
            btn.innerHTML = "<i class='fa-solid fa-stop'></i> Radarı Durdur";
            btn.className = "btn btn-sm btn-danger fw-bold";
            status.classList.remove('d-none');

            writeToTerminal("SİSTEM", "Otonom grid tarama motoru başlatıldı. Arka plan işçisi (Worker) dinleniyor...", false);

            // İlk çekim ve döngü (3 saniyede bir)
            fetchLiveFeed();
            radarInterval = setInterval(fetchLiveFeed, 3000);
        } else {
            btn.innerHTML = "<i class='fa-solid fa-play'></i> Otonom Radarı Başlat";
            btn.className = "btn btn-sm btn-primary fw-bold radar-pulse";
            status.classList.add('d-none');
            clearInterval(radarInterval);
            writeToTerminal("SİSTEM", "Otonom radar duraklatıldı.", false);
        }
    }

    // Backend'den son 10 kaydı çek (Sadece yeni olanları işle)
    function fetchLiveFeed() {
        fetch('/api/app/risk-analysis/latest-simulations?maxCount=10', {
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        })
            .then(response => {
                if (!response.ok) throw new Error("Köprü API hatası");
                return response.json();
            })
            .then(data => {
                // Eskiden yeniye doğru yazdırmak için diziyi tersine çevir
                const reversedData = data.reverse();

                reversedData.forEach(item => {
                    // Eğer bu ID'yi daha önce ekranda gösterdiysek atla
                    if (!processedGuids.has(item.id)) {
                        processedGuids.add(item.id);
                        processIncomingTelemetry(item, "OTONOM");
                    }
                });
            })
            .catch(err => console.warn("Live feed fetch error:", err));
    }

    // Gelen veriyi haritaya çiz ve terminale yaz
    function processIncomingTelemetry(data, source) {
        const score = data.calculatedRiskMultiplier;
        const lat = data.latitude.toFixed(4);
        const lon = data.longitude.toFixed(4);

        let color = "#6c757d"; // Gri (Güvenli Bölge)
        let isCritical = false;

        if (score >= 30) {
            color = "#e74c3c"; // Kırmızı
            isCritical = true;
        } else if (score > 0) {
            color = "#f1c40f"; // Sarı
        }

        // Haritaya Nokta Bırak
        const circleMarker = L.circleMarker([data.latitude, data.longitude], {
            radius: 8,
            fillColor: color,
            color: "#fff",
            weight: 1,
            opacity: 1,
            fillOpacity: 0.8
        }).addTo(markerGroup);

        circleMarker.bindPopup(`<b>Kaynak:</b> ${source}<br/><b>FWI:</b> ${score.toFixed(2)}`).openPopup();

        // Terminale Log Düş
        const logText = `Grid (${lat}, ${lon}) tarandı. FWI: ${score.toFixed(2)} - ${data.spreadRisk}`;
        writeToTerminal(source, logText, isCritical);

        // Kritikse Ajan Logunu Simüle Et (Worker zaten arkada ajanı tetikliyor)
        if (isCritical) {
            setTimeout(() => {
                writeToTerminal("AJAN", `Kritik risk (${score.toFixed(2)}) algılandı. BLOCK_POLICY otonom olarak devrede. İlgili birimler uyarıldı.`, true);
            }, 800); // 800ms gecikme efekti
        }
    }

    // Manuel Tıklama API Çağrısı
    function triggerManualAnalysis(lat, lng) {
        writeToTerminal("MANUEL", `Koordinat (${lat.toFixed(4)}, ${lng.toFixed(4)}) için anlık analiz başlatıldı...`, false);

        // Sadece geçici bir mavi pin koy
        L.marker([lat, lng]).addTo(markerGroup);

        fetch('/api/app/risk-analysis/submit-telemetry-and-analyze', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': abp.security.antiForgery.getToken()
            },
            body: JSON.stringify({
                latitude: lat,
                longitude: lng,
                distanceToPowerLineMeters: 0,
                windSpeedKmh: 0,
                slopePercentage: 0,
                vegetationType: "Manuel Gözlem"
            })
        })
            .then(response => response.json())
            .then(data => {
                // API'den dönen cevabı doğrudan işle (ID'yi listeye ekle ki radar tekrar çekmesin)
                processedGuids.add(data.id);
                processIncomingTelemetry(data, "MANUEL");
            })
            .catch(err => writeToTerminal("HATA", "Manuel analiz başarısız.", true));
    }

    // Terminale Yazı Yazdırma Fonksiyonu
    function writeToTerminal(tag, message, isCritical) {
        const terminal = document.getElementById('terminal');
        const time = new Date().toLocaleTimeString('tr-TR');

        const entry = document.createElement('div');
        entry.className = 'log-entry';

        const textClass = isCritical ? 'log-critical' : 'log-safe';

        entry.innerHTML = `
                <span class="log-time">[${time}]</span>
                <strong class="text-warning">[${tag}]</strong>
                <span class="${textClass}">${message}</span>
            `;

        terminal.appendChild(entry);

        // Otomatik en alta kaydır
        terminal.scrollTop = terminal.scrollHeight;
    }
</script>